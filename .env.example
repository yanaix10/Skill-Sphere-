# ==========================================
# SkillSphere Global Environment Reference
# ==========================================

# -----------------
# Server & Network Config
# -----------------
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=mongodb://127.0.0.1:27017/skillsphere
MONGO_URI=mongodb://127.0.0.1:27017/skillsphere
JWT_SECRET=skillsphere-coding-duel-secret-2026

# -----------------
# Code Runner Config (Judge0 / Mock)
# -----------------
# RUNNER: 'mock' for local dev without Judge0, or 'judge0' for production evaluation
RUNNER=mock
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=
JUDGE0_LANG_ID_PYTHON=71
JUDGE0_LANG_ID_CPP=54
JUDGE0_MAX_CONCURRENCY=4

# -----------------
# Runner Execution Limits
# -----------------
MAX_CODE_BYTES=20000
RUN_CPU_LIMIT_SEC=3
RUN_WALL_LIMIT_SEC=8
RUN_MEMORY_LIMIT_MB=256

# -----------------
# Coding Duel Game Rules Config
# -----------------
MATCH_QUESTION_COUNT=8
MATCH_TIME_CAP_SEC=2100
MATCH_MODE=sprint
MATCH_SAME_LANGUAGE=false
RECONNECT_GRACE_SEC=30
REVEAL_SOLUTIONS=true

# -----------------
# Quiz API (https://quizapi.io)
# -----------------
QUIZ_API_KEY=your_quiz_api_key_here
QUIZ_API_BASE_URL=https://quizapi.io/api/v1

# -----------------
# Firebase Admin SDK (stringified JSON or backend/src/config/serviceAccountKey.json)
# -----------------
FIREBASE_SERVICE_ACCOUNT=

# -----------------
# Frontend Config (frontend/.env)
# -----------------
VITE_API_BASE_URL=http://localhost:5000
