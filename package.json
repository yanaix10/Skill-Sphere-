{
  "name": "skill-sphere",
  "version": "1.0.0",
  "private": true,
  "description": "SkillSphere - Collaborative coding, quizzes, and competitive programming platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=skill-sphere-backend",
    "dev:frontend": "npm run dev --workspace=skill-sphere-frontend",
    "build": "npm run build --workspace=skill-sphere-frontend && (rm -rf dist && cp -r frontend/dist dist || true)",
    "build:all": "npm run build --workspace=skill-sphere-backend && npm run build --workspace=skill-sphere-frontend && (rm -rf dist && cp -r frontend/dist dist || true)",
    "build:backend": "npm run build --workspace=skill-sphere-backend",
    "build:frontend": "npm run build --workspace=skill-sphere-frontend",
    "lint:frontend": "npm run lint --workspace=skill-sphere-frontend",
    "test": "npm run test --workspace=skill-sphere-backend",
    "seed": "npm run seed --workspace=skill-sphere-backend",
    "demo:match": "npm run demo:match --workspace=skill-sphere-backend",
    "seed:dsa": "npm run seed:dsa --workspace=skill-sphere-backend",
    "test:engine": "npm run test:engine --workspace=skill-sphere-backend",
    "import:multipl": "npm run import:multipl --workspace=skill-sphere-backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
